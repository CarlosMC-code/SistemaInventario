<Project Sdk="Microsoft.NET.Sdk">
      <PropertyGroup>
        <TargetFramework>net48</TargetFramework>
        <RootNamespace>SistemaInventario.Presentacion</RootNamespace>
        <AssemblyName>SistemaInventario.Presentacion</AssemblyName>
        <LangVersion>7.3</LangVersion>
        <AutoGenerateBindingRedirects>true</AutoGenerateBindingRedirects>
        <OutputType>WinExe</OutputType><UseWindowsForms>true</UseWindowsForms><StartupObject>SistemaInventario.Presentacion.Program</StartupObject>
      </PropertyGroup>
      <ItemGroup><ProjectReference Include="..\SistemaInventario.Entidades\SistemaInventario.Entidades.csproj" />
<ProjectReference Include="..\SistemaInventario.LogicaNegocio\SistemaInventario.LogicaNegocio.csproj" /></ItemGroup>
    <!-- formularios -->
<ItemGroup>
    <Compile Update="LoginForm.cs"><SubType>Form</SubType></Compile>
