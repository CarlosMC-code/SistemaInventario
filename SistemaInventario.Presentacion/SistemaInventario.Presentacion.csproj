    <EmbeddedResource Update="LoginForm.resx"><DependentUpon>LoginForm.cs</DependentUpon></EmbeddedResource>
    <Compile Update="PrincipalForm.cs"><SubType>Form</SubType></Compile>
    <Compile Update="PrincipalForm.Designer.cs"><DependentUpon>PrincipalForm.cs</DependentUpon></Compile>
    <EmbeddedResource Update="PrincipalForm.resx"><DependentUpon>PrincipalForm.cs</DependentUpon></EmbeddedResource>
    <Compile Update="CategoriaForm.cs"><SubType>Form</SubType></Compile>
    <Compile Update="CategoriaForm.Designer.cs"><DependentUpon>CategoriaForm.cs</DependentUpon></Compile>
    <EmbeddedResource Update="CategoriaForm.resx"><DependentUpon>CategoriaForm.cs</DependentUpon></EmbeddedResource>
    <Compile Update="SuplidorForm.cs"><SubType>Form</SubType></Compile>
    <Compile Update="SuplidorForm.Designer.cs"><DependentUpon>SuplidorForm.cs</DependentUpon></Compile>
    <EmbeddedResource Update="SuplidorForm.resx"><DependentUpon>SuplidorForm.cs</DependentUpon></EmbeddedResource>
    <Compile Update="ProductoForm.cs"><SubType>Form</SubType></Compile>
    <Compile Update="ProductoForm.Designer.cs"><DependentUpon>ProductoForm.cs</DependentUpon></Compile>
    <EmbeddedResource Update="ProductoForm.resx"><DependentUpon>ProductoForm.cs</DependentUpon></EmbeddedResource>
    <Compile Update="PapeleraForm.cs"><SubType>Form</SubType></Compile>
    <Compile Update="PapeleraForm.Designer.cs"><DependentUpon>PapeleraForm.cs</DependentUpon></Compile>
    <EmbeddedResource Update="PapeleraForm.resx"><DependentUpon>PapeleraForm.cs</DependentUpon></EmbeddedResource>
</ItemGroup>
</Project>
